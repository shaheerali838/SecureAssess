# Client Environment Variables
# In production on Vercel, API calls default to same-origin /api/v1 automatically.
# Set VITE_API_URL only if backend API is hosted on a separate custom domain.
VITE_API_URL=

# Real-time WebSocket signaling server (e.g. wss://your-backend.onrender.com or custom signaling domain)
VITE_SOCKET_URL=http://localhost:7000
