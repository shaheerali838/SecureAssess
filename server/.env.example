NODE_ENV=development
PORT=7000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/secureassess
MONGODB_DB_NAME=secureassess

# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Storage (Local / S3 / Cloudinary)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@secureassess.com

# Initial Platform Owner Configuration
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Owner
ADMIN_EMAIL=owner@secureassess.com
ADMIN_PASSWORD=AdminSecure#2026
ADMIN_PHONE=

# Redis
REDIS_URL=redis://localhost:6379
